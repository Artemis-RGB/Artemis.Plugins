<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:nodes="clr-namespace:Artemis.Plugins.Nodes.ScreenCapture.Nodes"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Artemis.Plugins.Nodes.ScreenCapture.Nodes.PixelCaptureNodeCustomView"
             x:DataType="nodes:PixelCaptureNodeCustomViewModel">
    <StackPanel Spacing="5" Orientation="Horizontal">
        <controls:NumberBox VerticalAlignment="Center"
                            MinWidth="35"
                            SimpleNumberFormat="F1"
                            Classes="condensed"
                            AcceptsExpression="True"
                            Value="{CompiledBinding X}" />
        <controls:NumberBox VerticalAlignment="Center"
                            MinWidth="35"
                            SimpleNumberFormat="F1"
                            Classes="condensed"
                            AcceptsExpression="True"
                            Value="{CompiledBinding Y}" />
        <Button Classes="icon-button" Command="{CompiledBinding CaptureNextClick}">
            <avalonia:MaterialIcon Kind="Pipette" />
        </Button>
    </StackPanel>
</UserControl>